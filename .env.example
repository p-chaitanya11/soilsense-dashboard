# SoilSense ThingSpeak Configuration
# Replace with your actual ThingSpeak Channel ID and Read API Key
VITE_THINGSPEAK_CHANNEL_ID=
VITE_THINGSPEAK_READ_API_KEY=

# Auto refresh interval in seconds (default: 60, set to 0 to disable auto-poll)
VITE_AUTO_REFRESH_SECONDS=60

# Optional: Enable Demo Mode by default if credentials are missing
VITE_ENABLE_DEMO_FALLBACK=true
